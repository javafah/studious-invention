
Option Explicit

Dim sh, fso, temp, hta, f
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

temp = sh.ExpandEnvironmentStrings("%TEMP%")
hta = temp & "\Terminal.hta"

Set f = fso.CreateTextFile(hta, True)

f.WriteLine "<html><head><title>Terminal</title>"
f.WriteLine "<HTA:APPLICATION ID='Terminal' APPLICATIONNAME='Terminal' BORDER='thin' CAPTION='yes' SHOWINTASKBAR='yes' SCROLL='no' SINGLEINSTANCE='yes' />"
f.WriteLine "<style>"
f.WriteLine "body{margin:0;background:#080b10;color:#ddd;font-family:Consolas,monospace}"
f.WriteLine "#top{background:#202630;padding:12px;color:white;font-family:Segoe UI}"
f.WriteLine "#screen{height:calc(100vh - 115px);overflow-y:auto;padding:15px;white-space:pre-wrap}"
f.WriteLine "#bottom{position:absolute;bottom:0;width:100%;background:#151b24;padding:10px;box-sizing:border-box}"
f.WriteLine "#cmd{width:85%;background:#080b10;color:#65e69b;border:1px solid #455264;padding:10px;font:15px Consolas}"
f.WriteLine "button{background:#e99a36;color:#111;border:0;padding:11px 18px;font-weight:bold;cursor:pointer}"
f.WriteLine ".green{color:#65e69b}.red{color:#ff7777}"
f.WriteLine "</style>"

f.WriteLine "<script language='VBScript'>"
f.WriteLine "Dim sh, fso, folder, outFile, runFile"
f.WriteLine "Set sh=CreateObject(""WScript.Shell"")"
f.WriteLine "Set fso=CreateObject(""Scripting.FileSystemObject"")"
f.WriteLine "folder=sh.ExpandEnvironmentStrings(""%TEMP%"")"
f.WriteLine "outFile=folder & ""\terminal_output.txt"""
f.WriteLine "runFile=folder & ""\terminal_run.cmd"""

f.WriteLine "Sub AddLine(t)"
f.WriteLine " Dim e"
f.WriteLine " Set e=document.getElementById(""screen"")"
f.WriteLine " e.innerHTML=e.innerHTML & Replace(Replace(t,""<"",""&lt;""),"">"",""&gt;"") & ""<br>"""
f.WriteLine " e.scrollTop=e.scrollHeight"
f.WriteLine "End Sub"

f.WriteLine "Sub Window_OnLoad"
f.WriteLine " AddLine ""Terminal ready."""
f.WriteLine " AddLine ""Type help to see commands."""
f.WriteLine " AddLine """""
f.WriteLine " document.getElementById(""cmd"").focus"
f.WriteLine "End Sub"

f.WriteLine "Sub RunCommand"
f.WriteLine " Dim c, low, file, data, code"
f.WriteLine " c=Trim(document.getElementById(""cmd"").value)"
f.WriteLine " If c="""" Then Exit Sub"
f.WriteLine " document.getElementById(""cmd"").value="""""
f.WriteLine " AddLine ""C:\> "" & c"
f.WriteLine " low=LCase(c)"

f.WriteLine " Select Case low"
f.WriteLine " Case ""help"""
f.WriteLine " AddLine ""CUSTOM COMMANDS:"""
f.WriteLine " AddLine ""time | date | calendar | check | fun | joke | fact"""
f.WriteLine " AddLine ""sfc/scan | sfc/verify | sfc/scanlist | clear | version | exit"""
f.WriteLine " AddLine ""Normal Windows commands also work."""
f.WriteLine " Case ""time"""
f.WriteLine " AddLine ""Current time: "" & Time"
f.WriteLine " Case ""date"""
f.WriteLine " AddLine ""Current date: "" & Date"
f.WriteLine " Case ""calendar"""
f.WriteLine " AddLine ""     "" & MonthName(Month(Date)) & "" "" & Year(Date)"
f.WriteLine " AddLine ""Today: "" & WeekdayName(Weekday(Date))"
f.WriteLine " Case ""check"""
f.WriteLine " AddLine ""Computer: "" & sh.ExpandEnvironmentStrings(""%COMPUTERNAME%"")"
f.WriteLine " AddLine ""Processor: "" & sh.ExpandEnvironmentStrings(""%PROCESSOR_IDENTIFIER%"")"
f.WriteLine " AddLine ""Architecture: "" & sh.ExpandEnvironmentStrings(""%PROCESSOR_ARCHITECTURE%"")"
f.WriteLine " AddLine ""User: "" & sh.ExpandEnvironmentStrings(""%USERNAME%"")"
f.WriteLine " AddLine ""For detailed hardware information, use systeminfo."""
f.WriteLine " Case ""fun"""
f.WriteLine " AddLine ""Have a fantastic day! :)"""
f.WriteLine " Case ""joke"""
f.WriteLine " AddLine ""Why did the computer go to the doctor? It had a virus!"""
f.WriteLine " Case ""fact"""
f.WriteLine " AddLine ""A computer can perform billions of operations every second."""
f.WriteLine " Case ""version"""
f.WriteLine " AddLine ""Terminal version 1.0"""
f.WriteLine " Case ""clear"""
f.WriteLine " document.getElementById(""screen"").innerHTML="""""
f.WriteLine " Case ""exit"""
f.WriteLine " window.close"
f.WriteLine " Case ""sfc/scan"""
f.WriteLine " AddLine ""Starting Windows system file scan..."""
f.WriteLine " sh.Run ""cmd.exe /k sfc /scannow"",1,False"
f.WriteLine " Case ""sfc/verify"""
f.WriteLine " sh.Run ""cmd.exe /k sfc /verifyonly"",1,False"
f.WriteLine " Case ""sfc/scanlist"""
f.WriteLine " AddLine ""sfc /scannow - Scan and repair protected files"""
f.WriteLine " AddLine ""sfc /verifyonly - Verify protected files"""
f.WriteLine " AddLine ""sfc /scanfile - Scan a specific file"""
f.WriteLine " AddLine ""sfc /? - SFC help"""
f.WriteLine " Case Else"
f.WriteLine " ExecuteCMD c"
f.WriteLine " End Select"
f.WriteLine "End Sub"

f.WriteLine "Sub ExecuteCMD(c)"
f.WriteLine " Dim cmd, result, line"
f.WriteLine " cmd=""cmd.exe /d /c "" & Chr(34) & c & "" > "" & Chr(34) & outFile & "" 2>&1"""
f.WriteLine " On Error Resume Next"
f.WriteLine " sh.Run cmd,0,True"
f.WriteLine " If Err.Number<>0 Then"
f.WriteLine "  AddLine ""Could not run command."""
f.WriteLine "  Err.Clear"
f.WriteLine "  Exit Sub"
f.WriteLine " End If"
f.WriteLine " On Error GoTo 0"
f.WriteLine " If fso.FileExists(outFile) Then"
f.WriteLine "  Set result=fso.OpenTextFile(outFile,1)"
f.WriteLine "  Do Until result.AtEndOfStream"
f.WriteLine "   line=result.ReadLine"
f.WriteLine "   AddLine line"
f.WriteLine "  Loop"
f.WriteLine "  result.Close"
f.WriteLine " End If"
f.WriteLine "End Sub"

f.WriteLine "</script></head>"
f.WriteLine "<body>"
f.WriteLine "<div id='top'>Terminal</div>"
f.WriteLine "<div id='screen'></div>"
f.WriteLine "<div id='bottom'>"
f.WriteLine "<input id='cmd' type='text' placeholder='Enter command...' onkeydown='If window.event.keyCode=13 Then RunCommand'>"
f.WriteLine "<button onclick='RunCommand'>RUN</button>"
f.WriteLine "</div></body></html>"

f.Close

sh.Run "mshta.exe " & Chr(34) & hta & Chr(34),1,False
